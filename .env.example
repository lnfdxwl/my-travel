# 携程问道 API Key
# 获取方式：https://externalcallback.ctrip.com/skills/api/crew/qclaw/searchInfo
WENDAO_API_KEY=your_wendao_api_key_here

# Google Maps API Key（需安装 mcporter，用于景点地图链接和地理编码）
# 获取方式：https://console.cloud.google.com/apis/credentials
# 启用 API：gcloud beta services enable mapstools.googleapis.com
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
